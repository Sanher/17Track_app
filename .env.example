# --- App base ---
PORT=8787
APP_LOG_LEVEL=info
APP_JSON_LIMIT=256kb
APP_API_KEY=
TRACK17_TOKEN=

# --- IMAP worker ---
IMAP_INGEST_BASE_URL=http://127.0.0.1:8787
IMAP_INGEST_API_KEY=
IMAP_DEFAULT_OWNER=owner_a
IMAP_WORKER_DOTENV_PATH=.env
IMAP_ACCOUNTS_FILE=
IMAP_WORKER_STATE_PATH=./data/imap_worker_state.json
IMAP_WORKER_LOOKBACK_DAYS=30
IMAP_WORKER_FETCH_LIMIT=120
IMAP_INGEST_BATCH_SIZE=100
IMAP_INGEST_TIMEOUT_SEC=20
IMAP_WORKER_DRY_RUN=false

# JSON array with one object per mailbox account.
# Supported auth:
# - Gmail: "auth":"password" + "password_env":"ENV_NAME"
# - Outlook: "auth":"oauth2" + client/secret/refresh via *_env keys
IMAP_ACCOUNTS_JSON=[{"email":"correo1@gmail.com","provider":"gmail","owner":"owner_a","auth":"password","password_env":"IMAP_GMAIL_1_APP_PASSWORD"},{"email":"correo2@gmail.com","provider":"gmail","owner":"owner_a","auth":"password","password_env":"IMAP_GMAIL_2_APP_PASSWORD"},{"email":"correo3@gmail.com","provider":"gmail","owner":"owner_a","auth":"password","password_env":"IMAP_GMAIL_3_APP_PASSWORD"},{"email":"correo4@gmail.com","provider":"gmail","owner":"owner_b","auth":"password","password_env":"IMAP_GMAIL_4_APP_PASSWORD"},{"email":"filtro@correo.com","provider":"gmail","owner":"owner_b","auth":"password","password_env":"IMAP_GMAIL_FILTER_APP_PASSWORD","filters":{"only_amazon":true,"destination_keywords_all":["mislata"],"allowed_sender_domains":["amazon.es","amazon.com"],"require_dkim_pass":true}},{"email":"correo6@outlook.com","provider":"outlook","owner":"owner_b","auth":"oauth2","tenant":"consumers","client_id_env":"OUTLOOK_IMAP_CLIENT_ID","client_secret_env":"OUTLOOK_IMAP_CLIENT_SECRET","refresh_token_env":"OUTLOOK_IMAP_REFRESH_TOKEN"}]

# Gmail app passwords
IMAP_GMAIL_1_APP_PASSWORD=
IMAP_GMAIL_2_APP_PASSWORD=
IMAP_GMAIL_3_APP_PASSWORD=
IMAP_GMAIL_4_APP_PASSWORD=
IMAP_GMAIL_FILTER_APP_PASSWORD=

# Outlook OAuth2
OUTLOOK_IMAP_CLIENT_ID=
OUTLOOK_IMAP_CLIENT_SECRET=
OUTLOOK_IMAP_REFRESH_TOKEN=
